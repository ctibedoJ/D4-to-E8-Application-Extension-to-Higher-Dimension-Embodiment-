def construct_e9_lattice():
    """49-byte axiomatic E₉(416) generator"""
    
    # Axiom β1: φ-tuned weights (h=42)
    phi = (1 + 5**0.5)/2
    k = np.arange(9)
    w = phi**(-k/42); w /= w.sum()
    
    # Axiom β2+β3: Gram matrix
    G = 2*np.eye(9)*w[:,None] - np.outer(w,w)
    
    # Axiom β4: Null root extraction
    alpha0 = null_space(G.T)[0]
    alpha0 /= np.linalg.norm(alpha0)
    
    # E9 coordinates: φ-scaled roots
    roots_e9 = []
    for i in range(9):
        root_i = phi**(i/42) * np.eye(9)[:,i]
        roots_e9.append(root_i)
        roots_e9.append(-root_i)  # ± pairs
    
    # Full 416D lattice
    lattice_e9 = np.vstack(roots_e9 + [alpha0, -alpha0])
    
    return G, alpha0, lattice_e9

G_e9, alpha0, lattice = construct_e9_lattice()
print(f"E9 lattice constructed: {lattice.shape[0]} nodes")
print(f"Null root verified: ||G α₀|| = {np.linalg.norm(G_e9 @ alpha0):.2e}")
